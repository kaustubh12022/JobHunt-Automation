"forceLogging\":false},\"privileged\":{\"value\":1,\"group\":\"privileged\",\"allocationId\":\"\"}},\"isMobile\":false,\"locale\":{\"language\":\"en\",\"country\":\"IN\"},\"trackingKey\":\"011d7d44-5390-4391-b839-cf7fe2ffd627\",\"pageId\":\"viewjob\",\"country\":\"IN\",\"language\":\"en\",\"ctk\":\"1jt4aqqdr259f000\",\"providerMetaData\":{\"baseSecureUrl\":\"https://secure.indeed.com\",\"baseUrl\":\"http://in.indeed.com\",\"branding\":\"headerless\",\"dismissible\":true,\"email\":\"\",\"from\":\"jsfe-serp-passport-intercept\",\"type\":\"modal\",\"fullScreen\":false}};\n\n    window.mosaic.publicPaths={};\n    window.mosaic.publicPaths[\"mosaic-provider-reportcontent\"]=\"https://c03.s3.indeed.com/mosaic-provider-reportcontent/dist/\";\n    window.mosaic.publicPaths[\"js-match-insights-provider-job-details\"]=\"https://c03.s3.indeed.com/js-match-insights-provider/dist/\";\n    window.mosaic.publicPaths[\"mosaic-provider-jobcards\"]=\"https://c03.s3.indeed.com/mosaic-provider-jobcards/dist/\";\n    window.mosaic.publicPaths[\"mosaic-provider-passport-intercept\"]=\"https://c03.s3.indeed.com/mosaic-provider-passport-intercept/dist/\";\n</script>\n<script src=\"https://c03.s3.indeed.com/mosaic-common/dist/loadProviders.cda9458838f1be6847bd.js?cacheKey=1\" async crossorigin=\"anonymous\"></script>\n<script id=\"mosaic-translation-overrides\">\n    this.mosaic = this.mosaic || {}; this.mosaic.i18nOverrides = this.mosaic.i18nOverrides || {};\n</script>\n\n\n        \n\n        <script type=\"application/ld+json\">{\"@context\":\"http:\\u002F\\u002Fschema.org\",\"@type\":\"JobPosting\",\"baseSalary\":{\"@type\":\"MonetaryAmount\",\"currency\":\"INR\",\"value\":{\"@type\":\"QuantitativeValue\",\"maxValue\":10000,\"minValue\":7000,\"unitText\":\"MONTH\"}},\"datePosted\":\"2026-07-08T10:19:56.33Z\",\"description\":\"\\u003Cp>Before coming in for the interview, please take a moment to visit our website and get familiar with the kind of work we do.\\u003C\\u002Fp>\\n\\u003Cp>\\u003Cb>About the Role\\u003C\\u002Fb>\\u003C\\u002Fp>\\n\\u003Cp>We’re looking for a Full Stack Developer who’s comfortable working with both frontend and backend technologies. You’ll build and maintain fast, reliable web applications using \\u003Cb>Next.js\\u003C\\u002Fb> and \\u003Cb>Nest.js\\u003C\\u002Fb>, working closely with designers and content teams.\\u003C\\u002Fp>\\n\\u003Cp>If you enjoy solving problems and building things end to end, this role fits well.\\u003C\\u002Fp>\\n\\u003Cp>\\u003Cb>What You’ll Do\\u003C\\u002Fb>\\u003C\\u002Fp>\\n\\u003Cul>\\n \\u003Cli>Build and maintain web applications using Next.js and Nest.js\\u003C\\u002Fli>\\n \\u003Cli>Create responsive, mobile-friendly interfaces that work across browsers\\u003C\\u002Fli>\\n \\u003Cli>Integrate APIs, third-party tools, and custom features\\u003C\\u002Fli>\\n \\u003Cli>Fix bugs and improve performance when issues come up\\u003C\\u002Fli>\\n \\u003Cli>Collaborate with designers and content creators for smooth user experiences\\u003C\\u002Fli>\\n\\u003C\\u002Ful>\\n\\u003Cp>\\u003Cb>What We’re Looking For\\u003C\\u002Fb>\\u003C\\u002Fp>\\n\\u003Cul>\\n \\u003Cli>0–1 year of experience in full stack development\\u003C\\u002Fli>\\n \\u003Cli>Strong understanding of HTML, CSS, JavaScript, TypeScript, and Node.js\\u003C\\u002Fli>\\n \\u003Cli>Hands-on experience with Next.js and Nest.js\\u003C\\u002Fli>\\n \\u003Cli>Knowledge of REST APIs, databases, and Git\\u003C\\u002Fli>\\n \\u003Cli>Good problem-solving skills and attention to detail\\u003C\\u002Fli>\\n\\u003C\\u002Ful>\\n\\u003Cp>\\u003Cb>Bonus (Nice to Have)\\u003C\\u002Fb>\\u003C\\u002Fp>\\n\\u003Cul>\\n \\u003Cli>Basic understanding of SEO and performance optimization\\u003C\\u002Fli>\\n \\u003Cli>Experience with server-side rendering (SSR) and static site generation (SSG)\\u003C\\u002Fli>\\n\\u003C\\u002Ful>\\n\\u003Cp>\\u003Cb>Why Join Us\\u003C\\u002Fb>\\u003C\\u002Fp>\\n\\u003Cul>\\n \\u003Cli>Supportive and collaborative team\\u003C\\u002Fli>\\n \\u003Cli>Clear growth and learning opportunities\\u003C\\u002Fli>\\n \\u003Cli>Flexible work hours with remote options\\u003C\\u002Fli>\\n\\u003C\\u002Ful>\\n\\u003Cp>If you’re excited about building modern web applications and growing your skills, we’d love to connect.\\u003C\\u002Fp>\\n\\u003Cp>Job Type: Internship\\u003C\\u002Fp>\\n\\u003Cp>Pay: ₹7,000.00 - ₹10,000.00 per month\\u003C\\u002Fp>\\n\\u003Cp>Work Location: In person\\u003C\\u002Fp>\",\"directApply\":true,\"employmentType\":[\"INTERN\"],\"hiringOrganization\":{\"@type\":\"Organization\",\"name\":\"Metaminds Studio\",\"sameAs\":\"https:\\u002F\\u002Fin.indeed.com\\u002Fcmp\\u002FMetaminds-Studio\"},\"jobLocation\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"IN\",\"addressLocality\":\"\",\"addressRegion\":\"MH\"}},\"title\":\"Full Stack Developer Intern\",\"validThrough\":\"2026-11-06T21:59:12.346Z\"}</script>\n\n        \n\n        \n    <script>(function(){function c(){var b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a18a404889a1cec4',t:'MTc4MzYzMDc1Mg=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n"
