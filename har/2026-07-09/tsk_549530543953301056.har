tcontent\":false,\"js-match-insights-provider-job-details\":false,\"js-match-insights-provider\":false,\"mosaic-provider-passport-intercept\":false,\"mosaic-provider-jobcards\":false},\"ctaEnticer\":null,\"ctk\":\"1jt4aqqdr259f000\",\"datePublished\":null,\"deploymentGroupToken\":\"0BAC16470FFD878CB7C2CAABAC75A66D46CAC66727BF2D6220539120C14284\",\"desktop\":true,\"dislikeFrom2paneEnabled\":true,\"downloadAppButtonModel\":null,\"dsanr\":false,\"employerInsightsModel\":null,\"employerOutreachEngagementModel\":null,\"employerResponsiveCardModel\":null,\"from\":null,\"globalnavFooterHTML\":\"\",\"globalnavHeaderHTML\":\"\",\"hasGrpKey\":false,\"hiringInsightsModel\":{\"age\":\"1 day ago\",\"employerLastReviewed\":null,\"employerResponsiveCardModel\":null,\"numOfCandidates\":\"1\",\"postedToday\":false,\"recurringHireText\":null,\"urgentlyHiringModel\":null},\"hostQueryExecutionResult\":{\"data\":{\"jobData\":{\"__typename\":\"JobDataPayload\",\"results\":[{\"__typename\":\"JobDataResult\",\"trackingKey\":\"5-fra1-3-1jt4aqqg225dkg00\",\"job\":{\"__typename\":\"Job\",\"key\":\"8c155e7d83a6a1f5\",\"title\":\"Full Stack Developer Intern\",\"sourceEmployerName\":\"Metaminds Studio\",\"datePublished\":1783505996330,\"expired\":false,\"language\":\"en\",\"normalizedTitle\":\"full stack developer\",\"refNum\":\"b7ee6481-33f1-49eb-bb5b-c4c411c8b46d\",\"expirationDate\":null,\"sponsoredEmployerKey\":null,\"brandingEligibility\":{\"__typename\":\"BrandingEligibilityForJob\",\"shouldShowBranding\":false,\"brandingInformation\":null,\"brandingAttribution\":[]},\"tracking\":{\"__typename\":\"JobTrackingResult\",\"jobClick\":{\"__typename\":\"JobTrackingJobClickResult\",\"url\":\"http:\\u002F\\u002Fin.indeed.com\\u002Frc\\u002Fclk?jk=8c155e7d83a6a1f5&bb=Givm7xdvPw-B8MvAKaVCZ-qQGkl18yIVpzc56fxrSKp7TTp8cREuU1KVjbPKVVNKkB_BXf9CpSROX8MydsB7aKoqeqv-md9u&xkcb=SoCI67M3hkdki9z5bp0LbzkdCdPP\"}},\"source\":{\"__typename\":\"JobSource\",\"key\":\"AAAAARp43EhebyGfRCT\\u002FyOnHipOVro3aakpr9aeEE6w1bBlzME6jpw==\",\"name\":\"Indeed\"},\"feed\":{\"__typename\":\"JobFeed\",\"key\":\"AAAAATz1LkceE6fW3CrsQgS0qpd3FVOf\\u002FlXNWNJPWjHwFa4uija1pw==\",\"isDradis\":true,\"feedSourceType\":\"EMPLOYER\"},\"url\":\"http:\\u002F\\u002Fin.indeed.com\\u002Fjob\\u002Ffull-stack-developer-intern-8c155e7d83a6a1f5\",\"dateOnIndeed\":1783505996330,\"description\":{\"__typename\":\"JobDescription\",\"html\":\"\\u003Cp>Before coming in for the interview, please take a moment to visit our website and get familiar with the kind of work we do.\\u003C\\u002Fp>\\u003Cp>\\u003Cb>About the Role\\u003C\\u002Fb>\\u003C\\u002Fp>\\u003Cp>We&rsquo;re looking for a Full Stack Developer who&rsquo;s comfortable working with both frontend and backend technologies. You&rsquo;ll build and maintain fast, reliable web applications using \\u003Cb>Next.js\\u003C\\u002Fb> and \\u003Cb>Nest.js\\u003C\\u002Fb>, working closely with designers and content teams.\\u003C\\u002Fp>\\u003Cp>If you enjoy solving problems and building things end to end, this role fits well.\\u003C\\u002Fp>\\u003Cp>\\u003Cb>What You&rsquo;ll Do\\u003C\\u002Fb>\\u003C\\u002Fp>\\u003Cul>\\u003Cli>Build and maintain web applications using Next.js and Nest.js\\u003C\\u002Fli>\\u003Cli>Create responsive, mobile-friendly interfaces that work across browsers\\u003C\\u002Fli>\\u003Cli>Integrate APIs, third-party tools, and custom features\\u003C\\u002Fli>\\u003Cli>Fix bugs and improve performance when issues come up\\u003C\\u002Fli>\\u003Cli>Collaborate with designers and content creators for smooth user experiences\\u003C\\u002Fli>\\u003C\\u002Ful>\\u003Cp>\\u003Cb>What We&rsquo;re Looking For\\u003C\\u002Fb>\\u003C\\u002Fp>\\u003Cul>\\u003Cli>0&ndash;1 year of experience in full stack development\\u003C\\u002Fli>\\u003Cli>Strong understanding of HTML, CSS, JavaScript, TypeScript, and Node.js\\u003C\\u002Fli>\\u003Cli>Hands-on experience with Next.js and Nest.js\\u003C\\u002Fli>\\u003Cli>Knowledge of REST APIs, databases, and Git\\u003C\\u002Fli>\\u003Cli>Good problem-solving skills and attention to detail\\u003C\\u002Fli>\\u003C\\u002Ful>\\u003Cp>\\u003Cb>Bonus (Nice to Have)\\u003C\\u002Fb>\\u003C\\u002Fp>\\u003Cul>\\u003Cli>Basic understanding of SEO and performance optimization\\u003C\\u002Fli>\\u003Cli>Experience with server-side rendering (SSR) and static site generation (SSG)\\u003C\\u002Fli>\\u003C\\u002Ful>\\u003Cp>\\u003Cb>Why Join Us\\u003C\\u002Fb>\\u003C\\u002Fp>\\u003Cul>\\u003Cli>Supportive and collaborative team\\u003C\\u002Fli>\\u003Cli>Clear growth and learning opportunities\\u003C\\u002Fli>\\u003Cli>Flexible work hours with remote options\\u003C\\u002Fli>\\u003C\\u002Ful>\\u003Cp>If you&rsquo;re excited about building modern web applications and growing your skills, we&rsquo;d love to connect.\\u003C\\u002Fp>\\u003Cp>Job Type: Internship\\u003C\\u002Fp>\\u003Cp>Pay: ₹7,000.00 - ₹10,000.00 per month\\u003C\\u002Fp>\\u003Cp>Work Location: In person\\u003C\\u002Fp>\",\"text\":\"Before coming in for the interview, please take a moment to visit our website and get familiar with the kind of work we do.\\n\\n*About the Role*\\n\\nWe’re looking for a Full Stack Developer who’s comfortable working with both frontend and backend technologies. You’ll build and maintain fast, reliable web applications using *Next.js* and *Nest.js*, working closely with designers and content teams.\\n\\nIf you enjoy solving problems and building things end to end, this role fits well.\\n\\n*What You’ll Do*\\n\\n* Build and maintain web applications using Next.js and Nest.js\\n* Create responsive, mobile-friendly interfaces that work across browsers\\n* Integrate APIs, third-party tools, and custom features\\n* Fix bugs and improve performance when issues come up\\n* Collaborate with designers and content creators for smooth user experiences\\n\\n*What We’re Looking For*\\n\\n* 0–1 year of experience in full stack development\\n* Strong understanding of HTML, CSS, JavaScript, TypeScript, and Node.js\\n* Hands-on experience with Next.js and Nest.js\\n* Knowledge of REST APIs, databases, and Git\\n* Good problem-solving skills and attention to detail\\n\\n*Bonus (Nice to Have)*\\n\\n* Basic understanding of SEO and performance optimization\\n* Experience with server-side rendering (SSR) and static site generation (SSG)\\n\\n*Why Join Us*\\n\\n* Supportive and collaborative team\\n* Clear growth and learning opportunities\\n* Flexible work hours with remote options\\n\\nIf you’re excited about building modern web applications and growing your skills, we’d love to connect.\\n\\nJob Type: Internship\\n\\nPay: ₹7,000.00 - ₹10,000.00 per month\\n\\nWork Location: In person\",\"semanticSegments\":[]},\"location\":{\"__typename\":\"JobLocation\",\"countryCode\":\"IN\",\"admin1Code\":\"MH\",\"admin1Name\":\"Maharashtra\",\"admin2Code\":\"1254661\",\"admin2Name\":\"Thane District\",\"admin3Code\":\"THN\",\"admin3Name\":\"Thane\",\"admin4Code\":\"270171\",\"admin4Name\":\"Wagle Estate\",\"city\":null,\"postalCode\":null,\"latitude\":19.186752,\"longitude\":72.95455,\"streetAddress\":null,\"fullAddress\":\"Wagle Estate, Thane, Maharashtra\",\"formatted\":{\"__typename\":\"FormattedJobLocation\",\"long\":\"Wagle Estate, Thane, Maharashtra\",\"short\":\"Wagle Estate, Thane, Maharashtra\"}},\"occupations\":[{\"__typename\":\"JobOccupation\",\"key\":\"5NN53\",\"label\":\"Software Development Occupations\"},{\"__typename\":\"JobOccupation\",\"key\":\"EHPW9\",\"label\":\"Technology Occupations\"},{\"__typename\":\"JobOccupation\",\"key\":\"HJSX6\",\"label\":\"Software Development & Architecture Occupations\"}],\"occupationMostLikelySuids\":[{\"__typename\":\"JobOccupation\",\"key\":\"5NN53\"}],\"benefits\":[{\"__typename\":\"JobAttribute\",\"key\":\"WZ9TD\",\"label\":\"Flexible schedule\"}],\"socialInsurance\":[],\"workingSystem\":[],\"requiredDocumentsCategorizedAttributes\":[],\"indeedApply\":{\"__typename\":\"JobIndeedApplyAttributes\",\"key\":\"\\u002FY291bnRyeT1JTiZsYW5ndWFnZT1lbiIsInJ